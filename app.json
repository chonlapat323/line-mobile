{
  "expo": {
    "name": "BeautyUp Sales",
    "slug": "line-sender-mobile",
    "version": "2.2.14",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "linesender",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beautyup.linesender",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.beautyup.linesender",
      "versionCode": 34,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BeautyUp Sales to access your location to record visit coordinates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BeautyUp Sales uses your photo library to attach existing photos of the storefront, shelf displays, or payment slips to your visit report, which your manager reviews to approve the visit and commission.",
          "cameraPermission": "BeautyUp Sales uses the camera to photograph the storefront, shelf displays, and payment slips during a sales visit. These photos are attached to your visit report for your manager to review and approve."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "164a363d-5ddb-4197-9383-86743c42bf4b"
      }
    },
    "owner": "saberakito"
  }
}
